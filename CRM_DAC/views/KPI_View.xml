     <!-- Server Action to manually trigger KPI calculation -->
    <record id="action_server_recalculate_kpi" model="ir.actions.server">
        <field name="name">Recalculate KPIs</field>
        <field name="model_id" ref="model_kpi_sale_daily"/>
        <field name="binding_model_id" ref="model_kpi_sale_daily"/>
        <field name="state">code</field>
        <field name="code">action = env['kpi.sale.daily'].action_run_kpi_calculation_manually()</field>
    </record>

    

</odoo>
