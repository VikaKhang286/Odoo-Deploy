<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================ -->
    <!-- VIEWS CHO PAGE.FM.CONVERSATION (CUỘC TRÒ                        <group>
                            <field name="status_state" string="Trạng thái"/>
                            <field name="require_processing" string="Có yêu cầu xử lý" widget="boolean_toggle"/>
                            <field name="is_internal_conversation" string="Cuộc trò chuyện nội bộ" widget="boolean_toggle"/>
                            <field name="status_label" string="Nhãn hiển thị" readonly="1"/>
                            <field name="suggestion_note" string="Ghi chú &amp; Gợi ý"/>
                            <field name="last_suggestion_at" widget="datetime" string="Cập nhật lần cuối"/>
                        </group>) -->
    <!-- ================================================ -->

    <record id="view_page_fm_conversation_search" model="ir.ui.view">
        <field name="name">page.fm.conversation.search</field>
        <field name="model">page.fm.conversation</field>
        <field name="arch" type="xml">
            <search string="Search Conversations">
                <field name="name" string="Customer/Conv ID"/>
                <field name="customer_name_fm"/>
                <field name="conversation_fm_id"/>
                <field name="customer_fm_id" string="Pancake ID"/>
                <field name="last_message_snippet"/>
                <field name="platform_fm"/>
                <field name="page_fm_id_str_related" string="Page FM ID"/>
                
                <filter string="Chưa đọc" name="filter_unread" domain="[('is_unread_fm', '=', True)]"/>
                <filter string="Đã đọc" name="filter_read" domain="[('is_unread_fm', '=', False)]"/>
                <filter string="Yêu cầu xử lý" name="filter_require_processing" domain="[('require_processing', '=', True)]"/>
                <filter string="Cuộc trò chuyện nội bộ" name="filter_internal" domain="[('is_internal_conversation', '=', True)]"/>
                <filter string="Cuộc trò chuyện khách hàng" name="filter_external" domain="[('is_internal_conversation', '=', False)]"/>
                <separator/>
                <filter name="my_conversations" string="Của tôi"
                        domain="['|', ('owner_id', '=', uid), ('participant_user_ids', 'in', [uid])]"/>
                <separator/>
                <field name="page_fm_page_id" string="Page (Odoo)"/>
                <group expand="0" string="Group By">
                    <filter string="Theo phụ trách" name="group_by_owner" context="{'group_by': 'owner_id'}"/>
                    <filter string="Page" name="group_by_page" context="{'group_by': 'page_fm_page_id'}"/>
                    <filter string="Platform" name="group_by_platform" context="{'group_by': 'platform_fm'}"/>
                    <filter string="Trạng thái đọc" name="group_by_is_unread" context="{'group_by': 'is_unread_fm'}"/>
                    <filter string="Trạng thái xử lý" name="group_by_status" context="{'group_by': 'status_state'}"/>
                    <filter string="Loại cuộc trò chuyện" name="group_by_internal" context="{'group_by': 'is_internal_conversation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_page_fm_conversation_list" model="ir.ui.view">
        <field name="name">page.fm.conversation.list</field>
        <field name="model">page.fm.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversations">
                <header>
                    <!-- CÁC NÚT CẦN THIẾT -->
                    <button name="sync_all_conversations_scheduled"
                            type="object"
                            string="Đồng bộ đã chọn"
                            class="btn-primary"
                            groups="dac_erp.group_dac_erp_manager"/>
                    <button name="action_sync_messages_button"
                            type="object"
                            string="Đồng bộ tin nhắn"
                            class="btn-success"
                            context="{'load_all': True}"
                            groups="dac_erp.group_dac_erp_manager"/>
                    <button name="action_sync_tags_from_page"
                            type="object"
                            string="Đồng bộ Tags"
                            class="btn-primary"
                            groups="dac_erp.group_dac_erp_manager"/>
                    <button name="action_clear_token_cache"
                            type="object"
                            string="Xóa cache page"
                            class="btn-warning"
                            groups="dac_erp.group_dac_erp_manager"/>
                    <button name="action_sync_all_conversations_force"
                            type="object"
                            string="Đồng bộ Tất cả"
                            class="btn-danger"
                            confirm="Bạn có chắc muốn sync TOÀN BỘ conversations không filter? Sẽ mất nhiều thời gian đấy!"
                            groups="dac_erp.group_dac_erp_manager"/>
                </header>
                
                <field name="partner_id" string="Khách Hàng" widget="many2one_avatar"/>
                <field name="last_message_snippet_clean" string="Tin Nhắn Cuối"/>
                <field name="last_message_at_fm" string="Thời Gian Tin Nhắn Cuối" optional="show" widget="datetime"/>
                <field name="platform_fm" string="Platform"/>
                <field name="last_update_at" string="Cập nhật mới nhất"/>
                <field name="is_unread_fm" widget="boolean_toggle" string="Chưa Đọc"/>
                <field name="require_processing" widget="boolean_toggle" string="Cần Xử Lý"/>
                <field name="is_internal_conversation" widget="boolean_toggle" string="Nội Bộ"/>
                <field name="status_state" string="Trạng Thái"/>
                <field name="last_processing_change_at" string="Thay đổi xử lý lần cuối" optional="show"/>
                <field name="page_fm_page_id" optional="show" string="Page (Odoo)"/>
                <field name="page_fm_id_str_related" optional="hidden"/>
            </list>
        </field>
    </record>

    <record id="view_page_fm_conversation_form" model="ir.ui.view">
        <field name="name">page.fm.conversation.form</field>
        <field name="model">page.fm.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation">
                <header>
                    <button name="action_sync_messages_button" 
                            type="object" 
                            string="Đồng bộ tin nhắn" 
                            class="btn-success" 
                            context="{'load_all': True}"
                            groups="dac_erp.group_dac_erp_manager"/>
                    <button name="action_sync_tags_from_page"
                            type="object"
                            string="Đồng bộ Tags"
                            class="btn-primary"
                            groups="dac_erp.group_dac_erp_manager"/>
                    <button name="action_clear_token_cache"
                            type="object"
                            string="Xóa cache page"
                            class="btn-warning"
                            groups="dac_erp.group_dac_erp_manager"/>
                    <button name="action_debug_sync_assignees" 
                            type="object" 
                            string="🔍 DEBUG: Sync &amp; Log Assignees" 
                            class="btn-danger" 
                            groups="base.group_system"
                            help="Force sync conversation và log chi tiết quá trình gán người phụ trách"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_partner"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user">
                            <field name="partner_id" widget="statinfo" string="Khách hàng"/>
                        </button>
                        <button name="action_open_partner_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart">
                            <span class="o_stat_info">
                                <span class="o_stat_text">Đơn hàng</span>
                            </span>
                        </button>
                    </div>
                    
                    <group>
                        <group>
                            <field name="partner_id" string="Khách hàng" readonly="1" />
                            <field name="customer_name_fm" string="Tên KH (pancake)" readonly="1"/>
                            <field name="customer_fm_id" string="Id (pancake)" readonly="1"/>
                            <field name="platform_fm" string="Nền tảng (pancake)" readonly="1"/>
                        </group>
                        <group>
                            <field name="conversation_fm_id" readonly="1"/>
                            <field name="page_fm_page_id" options="{'no_create': True, 'no_open': False}" readonly="1"/>
                            <field name="page_fm_id_str_related" readonly="1"/>
                            <button name="action_open_on_pancake"
                                type="object"
                                string="Mở Pancake"
                                class="btn-primary"
                                icon="fa-external-link"/>
                        </group>
                    </group>
                    
                    <group string="Chi tiết">
                        <group>
                            <field name="last_message_snippet_clean" string="Tin nhắn cuối (đã xử lý)" readonly="1" widget="text" nolabel="0"/>
                            <field name="updated_at_fm" string="Thời gian cập nhật" readonly="1"/>
                            <field name="is_unread_fm" string="Chưa đọc"/>
                            <field name="last_message_sync_fm" string="Thời gian đồng bộ tin nhắn cuối" readonly="1" groups="dac_erp.group_dac_erp_manager"/>
                            <field name="last_update_at" string="Cập nhật lần cuối" widget="datetime" readonly="1"/>
                        </group>
                        <group>
                            <field name="status_state" string="Trạng thái"/>
                            <field name="require_processing" string="Có yêu cầu xử lý" widget="boolean_toggle"/>
                            <field name="status_label" string="Nhãn hiển thị" readonly="1"/>
                            <field name="suggestion_note" string="Ghi chú &amp; Gợi ý" widget="text"/>
                            <field name="last_processing_change_at" widget="datetime" string="Xử lý lần cuối" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Tin nhắn">
                            <field name="conv_message_ids" readonly="1" context="{'list_view_ref': 'CRM_DAC.view_page_fm_message_list'}"
                                    mode="list,form"
                                    views="[(list, 'CRM_DAC.view_page_fm_message_list'), (form, 'CRM_DAC.view_page_fm_message_form')]">
                            </field>
                        </page>
                        <page string="Pancake Tags" groups="dac_erp.group_dac_erp_manager">
                            <group>
                                <div class="oe_button_box">
                                    <button name="action_sync_pancake_tags_manual"
                                            type="object"
                                            string="Sync Tags lên Pancake"
                                            class="btn-primary"
                                            icon="fa-cloud-upload"/>
                                </div>
                                <field name="pancake_tag_ids" widget="many2many_tags" 
                                       options="{'no_create': True, 'no_open': True}"
                                       placeholder="Chọn tags để sync lên Pancake..."/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Hướng dẫn sử dụng:</strong> 
                                <ul>
                                    <li><strong>Sync Tags:</strong> Chọn tags và bấm "Sync Tags lên Pancake" để áp dụng</li>
                                    <li><strong>Gỡ hoàn toàn:</strong> Bỏ chọn tất cả tags và bấm "Sync" để gỡ hết tags trên Pancake</li>
                                    <li><strong>Thông báo chi tiết:</strong> Sẽ hiển thị trạng thái thay đổi từ [cũ] → [mới]</li>
                                    <li><strong>Quyền hạn:</strong> Chỉ Manager mới có thể chỉnh sửa và sync tags này</li>
                                    <li><strong>Tự động sync:</strong> Tags này không bị ảnh hưởng bởi việc đồng bộ conversation từ Pancake</li>
                                </ul>
                            </div>
                        </page>
                        <page string="Phân công" groups="dac_erp.group_dac_erp_manager">
                            <group>
                                <field name="owner_id"/>
                                <field name="participant_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="is_internal_conversation"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_page_fm_conversation_kanban" model="ir.ui.view">
        <field name="name">page.fm.conversation.kanban</field>
        <field name="model">page.fm.conversation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="platform_fm" quick_create="false"> 
                <field name="name"/>
                <field name="conversation_fm_id"/>
                <field name="customer_name_fm"/>    
                <field name="last_message_snippet_clean"/>
                <field name="last_message_snippet"/>
                <field name="updated_at_fm"/>
                <field name="is_unread_fm"/>
                <field name="platform_fm"/>
                <field name="page_fm_page_id"/>
                <field name="require_processing"/>
                <field name="status_state"/>
                <field name="is_internal_conversation"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click {{ record.is_unread_fm.raw_value ? 'oe_kanban_card_new' : '' }} {{ record.require_processing.raw_value ? 'border-warning' : '' }}">
                            <div class="oe_kanban_card_header">
                                <div class="d-flex align-items-center">
                                    <!-- Logo platform -->
                                    <t t-if="record.platform_fm.raw_value == 'Zalo'">
                                        <img src="/CRM_DAC/static/img/zalo.png" alt="Zalo" style="width: 20px; height: 20px; margin-right: 8px;"/>
                                    </t>
                                    <t t-elif="record.platform_fm.raw_value == 'Facebook'">
                                        <img src="/CRM_DAC/static/img/facebook.png" alt="Facebook" style="width: 20px; height: 20px; margin-right: 8px;"/>
                                    </t>
                                    <t t-else="">
                                        <span style="margin-right: 8px; font-weight: bold; color: #6c757d;"><t t-esc="record.platform_fm.value"/></span>
                                    </t>
                                    <strong><field name="customer_name_fm"/></strong>
                                </div>
                                <span class="float-right">
                                    <t t-if="record.require_processing.raw_value">🔴</t>
                                    <t t-if="record.is_unread_fm.raw_value">📧</t>
                                    <t t-if="record.is_internal_conversation.raw_value">🏢</t>
                                </span>
                            </div>
                            <div class="oe_kanban_content">
                                <div><strong>Cập nhật:</strong> <field name="updated_at_fm"/></div>
                                <div><strong>Tin nhắn:</strong> <field name="last_message_snippet_clean"/></div>
                                <div><strong>Trạng thái:</strong> <field name="status_state"/></div>
                            </div>
                            <div class="oe_clear"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_page_fm_conversation_all" model="ir.actions.act_window">
        <field name="name">Quản Lý Cuộc Trò Chuyện</field>
        <field name="res_model">page.fm.conversation</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_page_fm_conversation_search"/>
        <field name="context">{
            'search_default_filter_require_processing': 1,
            'search_default_filter_unread': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có cuộc trò chuyện nào được đồng bộ.
            </p>
            <p>
                Để bắt đầu, hãy đồng bộ các Pages trước, sau đó sử dụng các nút:
            </p>
            <ul>
                <li><strong>🔄 Đồng Bộ Toàn Bộ (Batch)</strong> - Đồng bộ tất cả conversations</li>
                <li><strong>⚡ Sync Ngay (Background)</strong> - Đồng bộ nền không chặn UI</li>
            </ul>
        </field>
    </record>

    <!-- ===================================== -->
    <!-- VIEWS CHO MESSAGE (TIN NHẮN CHI TIẾT) -->
    <!-- ===================================== -->

    <record id="view_page_fm_message_list" model="ir.ui.view">
        <field name="name">page.fm.message.list</field>
        <field name="model">page.fm.message</field>
        <field name="arch" type="xml">
            <list string="Nội Dung Tin Nhắn" create="false" delete="false" editable="bottom"
                    default_order="inserted_at_fm desc, id desc">
                <field name="inserted_at_fm" string="Thời gian" readonly="1"/>
                <field name="previous_time" string="Tin nhắn trước" optional="hidden" readonly="1"/>
                <field name="sender_name_fm" string="Sender" readonly="1"/>
                <field name="staff" string="Staff" readonly="1" widget="many2one_avatar"/>
                <field name="name" string="Nội dung tin nhắn" widget="text" />
                <field name="url_content" string="Đường dẫn" widget="url" readonly="1"/>
                <field name="attachments_json" optional="hidden" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_page_fm_message_form" model="ir.ui.view">
        <field name="name">page.fm.message.form</field>
        <field name="model">page.fm.message</field>
        <field name="arch" type="xml">
            <form string="Raw Message JSON">
                <sheet>
                    <group>
                        <field name="inserted_at_fm" readonly="1"/>
                        <field name="name" string="Tin Nhắn" readonly="1"/>                        
                        <field name="attachments_json" string="Attachments JSON" readonly="1" widget="text" class="o_field_widget" style="white-space: pre-wrap"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
