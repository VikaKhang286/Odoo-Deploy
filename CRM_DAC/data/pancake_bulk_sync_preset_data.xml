<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="pancake_bulk_sync_preset_speed" model="pancake.bulk.sync.preset">
            <field name="name">Tốc độ cao</field>
            <field name="description">Ưu tiên tốc độ làm mới nhanh, phù hợp khi cần quét lại dữ liệu gấp.</field>
            <field name="preset_type">system</field>
            <field name="sequence">10</field>
            <field name="sync_batch_size">100</field>
            <field name="smart_recent_days">1</field>
            <field name="deep_recent_days">3</field>
            <field name="circuit_breaker_pause_minutes">5</field>
            <field name="runner_interval_number">1</field>
            <field name="runner_interval_type">minutes</field>
            <field name="stale_timeout_minutes">5</field>
            <field name="is_default_for_bulk_sync">False</field>
        </record>

        <record id="pancake_bulk_sync_preset_balanced" model="pancake.bulk.sync.preset">
            <field name="name">Cân bằng hiệu năng</field>
            <field name="description">Cân bằng giữa tốc độ, độ ổn định và tải hệ thống. Đây là mẫu mặc định.</field>
            <field name="preset_type">system</field>
            <field name="sequence">20</field>
            <field name="sync_batch_size">50</field>
            <field name="smart_recent_days">3</field>
            <field name="deep_recent_days">7</field>
            <field name="circuit_breaker_pause_minutes">15</field>
            <field name="runner_interval_number">2</field>
            <field name="runner_interval_type">minutes</field>
            <field name="stale_timeout_minutes">10</field>
            <field name="is_default_for_bulk_sync">True</field>
        </record>

        <record id="pancake_bulk_sync_preset_error_safe" model="pancake.bulk.sync.preset">
            <field name="name">Ổn định khi lỗi nhiều</field>
            <field name="description">Giảm tải và tăng thời gian nghỉ để hệ thống chịu lỗi tốt hơn khi API chập chờn.</field>
            <field name="preset_type">system</field>
            <field name="sequence">30</field>
            <field name="sync_batch_size">20</field>
            <field name="smart_recent_days">7</field>
            <field name="deep_recent_days">14</field>
            <field name="circuit_breaker_pause_minutes">30</field>
            <field name="runner_interval_number">5</field>
            <field name="runner_interval_type">minutes</field>
            <field name="stale_timeout_minutes">15</field>
            <field name="is_default_for_bulk_sync">False</field>
        </record>
    </data>
</odoo>
