<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <!-- Quản trị và Manager nhìn thấy tất cả -->
    <record id="crm_dac_rule_conv_admin_all" model="ir.rule">
      <field name="name">Conversations: admin/manager see all</field>
      <field name="model_id" ref="model_page_fm_conversation"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('dac_erp.group_dac_erp_manager'))]"/>
    </record>

    <!-- Người dùng nội bộ: chỉ thấy hội thoại mình phụ trách hoặc thuộc nhóm -->
    <record id="crm_dac_rule_conv_personal" model="ir.rule">
      <field name="name">Conversations: personal only</field>
      <field name="model_id" ref="model_page_fm_conversation"/>
      <field name="domain_force">['|', ('owner_id','=',user.id), ('participant_user_ids','in',[user.id])]</field>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="global" eval="False"/>
    </record>
  </data>
</odoo>
