<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-name="dac_report.ManagerDashboard">
        <div class="dac-manager-dashboard dac-viewport">
            <!-- Loading Spinner -->
            <div t-if="state.loading" class="dac-dashboard-loading">
                <i class="fa fa-spinner fa-spin fa-3x"/>
                <p>Đang tải dữ liệu...</p>
            </div>

            <!-- Dashboard Content -->
            <div t-else="" class="container-fluid p-4">
                
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h1 class="h3 mb-0">Dashboard Quản Lý</h1>
                        <p class="text-muted mb-0">Tổng quan hoạt động kinh doanh</p>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <!-- Week Quick Filters -->
                        <div class="btn-group week-quick-filters" role="group">
                            <button class="btn btn-sm btn-outline-primary" 
                                    t-att-class="state.filterMode === 'week' and state.selectedWeek === getCurrentWeekInMonth() ? 'active' : ''"
                                    t-on-click="selectThisWeek">
                                <i class="fa fa-calendar-day me-1"/>Tuần này
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" 
                                    t-on-click="selectLastWeek">
                                <i class="fa fa-calendar-minus me-1"/>Tuần trước
                            </button>
                        </div>
                        
                        <!-- Week Dropdown Selector -->
                        <div class="dropdown week-dropdown">
                            <button class="btn btn-sm btn-outline-info dropdown-toggle" 
                                    type="button" 
                                    data-bs-toggle="dropdown" 
                                    aria-expanded="false">
                                <i class="fa fa-list me-1"/>
                                <t t-if="state.filterMode === 'week'">
                                    Tuần <t t-esc="state.selectedWeek"/>
                                </t>
                                <t t-else="">
                                    Chọn tuần
                                </t>
                            </button>
                            <ul class="dropdown-menu">
                                <t t-foreach="getWeeksInMonth()" t-as="week" t-key="week.number">
                                    <li>
                                        <a class="dropdown-item" 
                                           t-att-class="state.filterMode === 'week' and state.selectedWeek === week.number ? 'active' : ''"
                                           t-on-click="() => this.selectWeekNumber(week.number)">
                                            <i class="fa fa-calendar-week me-2"/>
                                            <t t-esc="week.label"/> 
                                            <small class="text-muted ms-1">(<t t-esc="week.range"/>)</small>
                                        </a>
                                    </li>
                                </t>
                            </ul>
                        </div>
                        
                        <!-- Period Selector - Month/Year Picker -->
                        <div class="period-selector-container">
                            <div class="period-display" t-on-click="togglePeriodPicker">
                                <i class="fa fa-calendar me-2"/>
                                <span class="period-text" t-esc="getPeriodDisplayText()"/>
                                <i class="fa fa-chevron-down ms-2"/>
                            </div>
                            
                            <!-- Period Picker Dropdown -->
                            <div t-if="state.showPeriodPicker" class="period-picker-dropdown">
                                <div class="period-picker-header">
                                    <button class="period-nav-btn" t-on-click="() => this.navigateYear(-1)">
                                        <i class="fa fa-chevron-left"/>
                                    </button>
                                    <span class="period-year" t-esc="state.pickerYear"/>
                                    <button class="period-nav-btn" t-on-click="() => this.navigateYear(1)">
                                        <i class="fa fa-chevron-right"/>
                                    </button>
                                </div>
                                
                                <div class="period-picker-body">
                                    <!-- Month Grid -->
                                    <div class="period-months-grid">
                                        <t t-foreach="getMonthsList()" t-as="month" t-key="month.value">
                                            <button class="period-month-btn" 
                                                    t-att-class="isMonthSelected(month.value) ? 'active' : ''"
                                                    t-on-click="() => this.selectMonth(month.value)">
                                                <t t-esc="month.label"/>
                                            </button>
                                        </t>
                                    </div>
                                    
                                    <!-- Year Selection -->
                                    <button class="period-year-btn" 
                                            t-att-class="state.filterMode === 'year' ? 'active' : ''"
                                            t-on-click="selectYear">
                                        <i class="fa fa-calendar-check me-1"/>
                                        Cả năm <t t-esc="state.pickerYear"/>
                                    </button>
                                    
                                    <!-- Custom Range Option -->
                                    <button class="period-custom-btn" t-on-click="openCustomRange">
                                        <i class="fa fa-calendar-alt me-1"/>
                                        Tùy chỉnh
                                    </button>
                                </div>
                            </div>
                            
                            <!-- Custom Date Range Modal -->
                            <div t-if="state.showCustomRange" class="custom-range-modal">
                                <div class="custom-range-content">
                                    <div class="custom-range-header">
                                        <h6 class="mb-0">Chọn khoảng thời gian</h6>
                                        <button class="btn-close-custom" t-on-click="closeCustomRange">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                    <div class="custom-range-body">
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Từ ngày:</label>
                                            <input type="date" 
                                                   class="form-control" 
                                                   t-model="state.customDateFrom"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Đến ngày:</label>
                                            <input type="date" 
                                                   class="form-control" 
                                                   t-model="state.customDateTo"/>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-success flex-fill" t-on-click="applyCustomRange">
                                                <i class="fa fa-check me-1"/>Áp dụng
                                            </button>
                                            <button class="btn btn-secondary flex-fill" t-on-click="closeCustomRange">
                                                <i class="fa fa-times me-1"/>Hủy
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Export Button -->
                        <button class="btn btn-primary" t-on-click="exportReport">
                            Xuất Báo Cáo
                        </button>
                    </div>
                </div>

                <!-- KPI Cards -->
                <div class="row g-4 mb-4">
                    <!-- Card 1: Tổng Doanh Thu + Doanh Thu Dự Kiến -->
                    <div class="col-lg-3 col-md-6">
                        <div class="dashboard-card kpi-card p-3">
                            <div class="kpi-label">Tổng Doanh Thu</div>
                            <div class="kpi-value text-success">
                                <t t-esc="formatCurrency(state.data.total_revenue)"/>
                            </div>
                            <div class="mt-2 pt-2 border-top">
                                <div class="kpi-label-small text-muted">Doanh Thu Dự Kiến</div>
                                <div class="kpi-value-small text-dark">
                                    <t t-esc="formatCurrency(state.data.expected_revenue)"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: Công Nợ -->
                    <div class="col-lg-3 col-md-6">
                        <div class="dashboard-card kpi-card p-3">
                            <div class="kpi-label">Công Nợ</div>
                            <div class="kpi-value text-danger">
                                <t t-esc="formatCurrency(state.data.total_debt)"/>
                            </div>
                            <span class="text-muted small">Cần thu tiền</span>
                        </div>
                    </div>

                    <!-- Card 3: Doanh Số Báo Giá -->
                    <div class="col-lg-3 col-md-6">
                        <div class="dashboard-card kpi-card p-3">
                            <div class="kpi-label">Doanh Số Báo Giá</div>
                            <div class="kpi-value text-info">
                                <t t-esc="formatCurrency(state.data.quotation_revenue)"/>
                            </div>
                            <span class="text-muted small">Đơn đang báo giá</span>
                        </div>
                    </div>

                    <!-- Card 4: Đơn Đang Hoạt Động -->
                    <div class="col-lg-3 col-md-6">
                        <div class="dashboard-card kpi-card p-3">
                            <div class="kpi-label">Đơn Đang Hoạt Động</div>
                            <div class="kpi-value" style="color: #6f42c1;">
                                <t t-esc="state.data.active_orders"/>
                            </div>
                            <span class="text-muted small">Chưa hoàn thành</span>
                        </div>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="row g-4">
                    <!-- Left Column - Pipeline Overview -->
                    <div class="col-lg-8">
                        <div class="dashboard-card">
                            <div class="card-body p-4">
                                <h5 class="card-title mb-4">Tổng Quan Quy Trình Đơn Hàng</h5>

                                <!-- Quy Trình Đầu Phễu -->
                                <div class="pipeline-group">
                                    <div class="pipeline-group-title">Quy Trình Đầu Phễu</div>
                                    <div class="pipeline-stages">
                                        <!-- Báo giá -->
                                        <div class="stage-card stage-quotation" t-on-click="() => this.openOrdersByState('quotation')">
                                            <h6>Báo Giá</h6>
                                            <div class="stage-value"><t t-esc="state.data.quotation_count"/></div>
                                            <div class="stage-subtext">~ <t t-esc="formatCurrency(state.data.quotation_amount)"/></div>
                                        </div>

                                        <!-- Đặt cọc -->
                                        <div class="stage-card stage-deposit" t-on-click="() => this.openOrdersByState('deposit')">
                                            <h6>Đặt Cọc &amp; TK</h6>
                                            <div class="stage-value"><t t-esc="state.data.deposit_count"/></div>
                                            <div class="stage-subtext">~ <t t-esc="formatCurrency(state.data.deposit_amount)"/></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Quy Trình Thực Thi -->
                                <div class="pipeline-group">
                                    <div class="pipeline-group-title">Quy Trình Thực Thi</div>
                                    <div class="execution-group">
                                        <!-- Sản xuất -->
                                        <div class="stage-card stage-production" t-on-click="() => this.openOrdersByState('production')">
                                            <h6>Sản Xuất</h6>
                                            <div class="stage-value"><t t-esc="state.data.production_count"/></div>
                                            <div class="stage-subtext">~ <t t-esc="formatCurrency(state.data.production_amount)"/></div>
                                        </div>

                                        <!-- Rẽ nhánh -->
                                        <div class="execution-branches">
                                            <!-- Thi công/Lắp đặt -->
                                            <div class="stage-card stage-installation" t-on-click="() => this.openOrdersByState('installation')">
                                                <h6>Thi Công/Lắp Đặt</h6>
                                                <div class="stage-value"><t t-esc="state.data.installation_count"/></div>
                                                <div class="stage-subtext">~ <t t-esc="formatCurrency(state.data.installation_amount)"/></div>
                                            </div>

                                            <!-- Giao hàng -->
                                            <div class="stage-card stage-delivery" t-on-click="() => this.openOrdersByState('delivery')">
                                                <h6>Giao Hàng</h6>
                                                <div class="stage-value"><t t-esc="state.data.delivery_count"/></div>
                                                <div class="stage-subtext">~ <t t-esc="formatCurrency(state.data.delivery_amount)"/></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Quy Trình Hoàn Tất -->
                                <div class="pipeline-group">
                                    <div class="pipeline-group-title">Quy Trình Hoàn Tất</div>
                                    <div class="pipeline-stages">
                                        <!-- Thu tiền -->
                                        <div class="stage-card stage-payment" t-on-click="() => this.openOrdersByState('payment')">
                                            <h6>Thu Tiền</h6>
                                            <div class="stage-value"><t t-esc="state.data.payment_count"/></div>
                                            <div class="stage-subtext">~ <t t-esc="formatCurrency(state.data.payment_amount)"/></div>
                                        </div>

                                        <!-- Hoàn thành -->
                                        <div class="stage-card stage-completed" t-on-click="() => this.openOrdersByState('completed')">
                                            <h6>Hoàn Thành</h6>
                                            <div class="stage-value"><t t-esc="state.data.completed_count"/></div>
                                            <div class="stage-subtext">~ <t t-esc="formatCurrency(state.data.completed_amount)"/></div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Right Column - Action Center -->
                    <div class="col-lg-4">
                        <!-- Trung Tâm Hành Động -->
                        <div class="dashboard-card action-center">
                            <div class="card-header bg-white border-0 pt-3">
                                <h5 class="card-title mb-0">Trung Tâm Hành Động</h5>
                                <ul class="nav nav-tabs card-header-tabs mt-2">
                                    <li class="nav-item">
                                        <a class="nav-link" 
                                           t-att-class="state.activeTab === 'alerts' ? 'active' : ''"
                                           t-on-click="() => this.switchTab('alerts')"
                                           href="#">
                                            Cảnh Báo
                                            <t t-if="state.data.alerts.length > 0">
                                                <span class="badge bg-danger text-white ms-1">
                                                    <t t-esc="state.data.alerts.length"/>
                                                </span>
                                            </t>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" 
                                           t-att-class="state.activeTab === 'performance' ? 'active' : ''"
                                           t-on-click="() => this.switchTab('performance')"
                                           href="#">
                                            Hiệu Suất
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <div class="card-body p-2">
                                <!-- Alerts Tab -->
                                <div t-if="state.activeTab === 'alerts'">
                                    <table t-if="state.data.alerts.length > 0" class="table table-borderless table-hover align-middle mb-0">
                                        <tbody>
                                            <t t-foreach="state.data.alerts" t-as="alert" t-key="alert.id">
                                                <tr t-on-click="() => this.openOrder(alert.order_id)" 
                                                    style="cursor: pointer;"
                                                    t-att-class="alert.vip_class ? 'alert-row ' + alert.vip_class : 'alert-row'">
                                                    <td>
                                                        <span t-att-class="'badge bg-' + alert.priority">
                                                            <t t-esc="alert.label"/>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="fw-bold alert-order-number">
                                                            <t t-if="alert.order_number">
                                                                <t t-esc="alert.order_number"/>
                                                            </t>
                                                            <t t-else="">
                                                                Chưa có số ĐH
                                                            </t>
                                                        </div>
                                                        <small class="text-muted alert-customer-name">
                                                            <t t-esc="alert.customer_name"/>
                                                        </small>
                                                    </td>
                                                    <td class="text-end">
                                                        <i class="fa fa-chevron-right text-muted"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                    <div t-else="" class="text-center text-muted py-4">
                                        <i class="fa fa-check-circle fa-3x mb-2"/>
                                        <p>Không có cảnh báo nào</p>
                                    </div>
                                </div>
                                
                                <!-- Performance Tab - Gộp tất cả -->
                                <div t-if="state.activeTab === 'performance'" class="performance-all-in-one">
                                    
                                    <!-- Sales Performance -->
                                    <div class="performance-section mb-4">
                                        <h6 class="text-muted mb-3">Kinh Doanh</h6>
                                        <t t-if="state.data.sales_performance.length > 0">
                                            <t t-foreach="state.data.sales_performance" t-as="user" t-key="user.id">
                                                <div class="performance-item mb-3">
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <strong><t t-esc="user.name"/></strong>
                                                        <span class="text-success"><t t-esc="formatCurrency(user.revenue)"/></span>
                                                    </div>
                                                    <div class="progress" style="height: 8px;">
                                                        <div class="progress-bar bg-success" 
                                                             role="progressbar" 
                                                             t-att-style="'width: ' + user.progress + '%'"
                                                             t-att-aria-valuenow="user.progress"
                                                             aria-valuemin="0" 
                                                             aria-valuemax="100"/>
                                                    </div>
                                                    <small class="text-muted"><t t-esc="user.orders_count"/> đơn hàng</small>
                                                </div>
                                            </t>
                                        </t>
                                        <div t-else="" class="text-center text-muted py-2">
                                            <small>Chưa có dữ liệu</small>
                                        </div>
                                    </div>

                                    <!-- Design Performance -->
                                    <div class="performance-section mb-4">
                                        <h6 class="text-muted mb-3">Thiết Kế</h6>
                                        <t t-if="state.data.design_performance.length > 0">
                                            <t t-foreach="state.data.design_performance" t-as="user" t-key="user.id">
                                                <div class="performance-item mb-3">
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <strong><t t-esc="user.name"/></strong>
                                                        <span class="text-info"><t t-esc="user.completed"/> / <t t-esc="user.total"/></span>
                                                    </div>
                                                    <div class="progress" style="height: 8px;">
                                                        <div class="progress-bar bg-info" 
                                                             role="progressbar" 
                                                             t-att-style="'width: ' + user.progress + '%'"
                                                             t-att-aria-valuenow="user.progress"
                                                             aria-valuemin="0" 
                                                             aria-valuemax="100"/>
                                                    </div>
                                                    <small class="text-muted">Tỷ lệ hoàn thành: <t t-esc="user.progress"/>%</small>
                                                </div>
                                            </t>
                                        </t>
                                        <div t-else="" class="text-center text-muted py-2">
                                            <small>Chưa có dữ liệu</small>
                                        </div>
                                    </div>

                                    <!-- Production Performance -->
                                    <div class="performance-section">
                                        <h6 class="text-muted mb-3">Sản Xuất</h6>
                                        <t t-if="state.data.production_performance.length > 0">
                                            <t t-foreach="state.data.production_performance" t-as="user" t-key="user.id">
                                                <div class="performance-item mb-3">
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <strong><t t-esc="user.name"/></strong>
                                                        <span class="text-warning"><t t-esc="user.completed"/> / <t t-esc="user.total"/></span>
                                                    </div>
                                                    <div class="progress" style="height: 8px;">
                                                        <div class="progress-bar bg-warning" 
                                                             role="progressbar" 
                                                             t-att-style="'width: ' + user.progress + '%'"
                                                             t-att-aria-valuenow="user.progress"
                                                             aria-valuemin="0" 
                                                             aria-valuemax="100"/>
                                                    </div>
                                                    <small class="text-muted">Tỷ lệ hoàn thành: <t t-esc="user.progress"/>%</small>
                                                </div>
                                            </t>
                                        </t>
                                        <div t-else="" class="text-center text-muted py-2">
                                            <small>Chưa có dữ liệu</small>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
