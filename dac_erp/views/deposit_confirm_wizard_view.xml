<odoo>
    <data>
        <record id="view_deposit_confirm_wizard_form" model="ir.ui.view">
            <field name="name">deposit.confirm.wizard.form</field>
            <field name="model">deposit.confirm.wizard</field>
            <field name="arch" type="xml">
                <form string="Xác nhận đặt cọc">
                    <group>
                        <div class="o_form_label" style="color: red; font-weight: bold;">
                            Đây là hành động không thể thay đổi, vui lòng xác nhận lại các thông tin
                        </div>
                        <field name="confirm_read"/>
                    </group>
                    <footer>
                        <button string="Xác nhận" type="object" name="action_confirm" class="btn-primary"
                            invisible="confirm_read == False"/>
                        <button string="Hủy" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>