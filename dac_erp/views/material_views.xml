        <field name="name">dac.sale.material.list</field>
        <field name="model">dac.sale.material</field>
        <field name="arch" type="xml">
            <list string="Chất liệu" create="false" edit="false" delete="false"><field name="name"/></list>
        </field>
    </record>
    <record id="view_material_search" model="ir.ui.view">
        <field name="name">dac.sale.material.search</field>
        <field name="model">dac.sale.material</field>
        <field name="arch" type="xml"><search string="Chất liệu"><field name="name"/></search></field>
    </record>
    <record id="view_material_kanban" model="ir.ui.view">
        <field name="name">dac.sale.material.kanban</field>
        <field name="model">dac.sale.material</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" delete="false"><templates><t t-name="card"><field name="name"/></t></templates></kanban>
        </field>
    </record>
