<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search view -->
    <record id="view_dac_work_task_search" model="ir.ui.view">
        <field name="name">dac.work.task.search</field>
        <field name="model">dac.work.task</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm công việc">
                <field name="name" string="Tên công việc"/>
                <field name="assigned_user_id" string="Người thực hiện"/>
                <field name="order_id" string="Đơn hàng"/>
                <filter string="Của tôi" name="my_tasks"
                        domain="[('assigned_user_id','=',uid)]"/>
                <filter string="Đang làm" name="in_progress"
                        domain="[('state','=','in_progress')]"/>
                <filter string="Chưa thực hiện" name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Khẩn cấp" name="urgent"
                        domain="[('priority','=','urgent')]"/>
                <filter string="Quá hạn" name="overdue"
                        domain="[('deadline','!=',False),('deadline','&lt;',context_today().strftime('%Y-%m-%d 00:00:00')),('state','not in',['done','cancelled'])]"/>
                <separator/>
                <filter string="Thiết kế" name="type_design"
                        domain="[('task_type','=','design')]"/>
                <filter string="Thi công" name="type_production"
                        domain="[('task_type','=','production')]"/>
                <filter string="Khảo sát" name="type_survey"
                        domain="[('task_type','=','survey')]"/>
                <filter string="Bổ sung" name="type_supplement"
                        domain="[('task_type','=','supplement')]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Loại công việc"
                            context="{'group_by': 'task_type'}"/>
                    <filter name="group_user" string="Người thực hiện"
                            context="{'group_by': 'assigned_user_id'}"/>
                    <filter name="group_priority" string="Độ ưu tiên"
                            context="{'group_by': 'priority'}"/>
                    <filter name="group_order" string="Đơn hàng"
                            context="{'group_by': 'order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban view -->
    <record id="view_dac_work_task_kanban" model="ir.ui.view">
        <field name="name">dac.work.task.kanban</field>
        <field name="model">dac.work.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false"
                    class="o_dac_task_kanban">
                <field name="name"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="deadline"/>
                <field name="assigned_user_id"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div class="o_dac_task_card_order text-muted small mt-1"
                             t-if="record.order_id.value">
                            <i class="fa fa-file-text-o me-1"/>
                            <field name="order_id" readonly="1"/>
                        </div>
                        <div class="o_dac_task_card_partner text-muted small"
                             t-if="record.partner_id.value">
                            <i class="fa fa-user me-1"/>
                            <field name="partner_id" readonly="1"/>
                        </div>
                        <footer class="d-flex justify-content-between align-items-center mt-2">
                            <div class="d-flex gap-2 align-items-center">
                                <span t-attf-class="o_dac_priority_#{record.priority.raw_value}">
                                    <t t-esc="record.priority.value"/>
                                </span>
                                <span t-if="record.deadline.value"
                                      class="text-muted small">
                                    <i class="fa fa-calendar-o me-1"/>
                                    <field name="deadline" widget="date" readonly="1"/>
                                </span>
                            </div>
                            <field name="assigned_user_id"
                                   widget="many2one_avatar_user" readonly="1"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List view -->
    <record id="view_dac_work_task_tree" model="ir.ui.view">
        <field name="name">dac.work.task.tree</field>
        <field name="model">dac.work.task</field>
        <field name="arch" type="xml">
            <list string="Tasks"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="priority == 'urgent' and state not in ('done','cancelled')">
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="task_type" optional="show"/>
                <field name="priority"/>
                <field name="deadline"/>
                <field name="remind_at" optional="hide"/>
                <field name="order_id"/>
                <field name="assigned_user_id"/>
                <field name="created_by_agent" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Calendar view: lịch công việc theo deadline, màu theo loại task -->
    <record id="view_dac_work_task_calendar" model="ir.ui.view">
        <field name="name">dac.work.task.calendar</field>
        <field name="model">dac.work.task</field>
        <field name="arch" type="xml">
            <calendar string="Lịch công việc" date_start="deadline"
                      color="task_type" mode="month"
                      event_open_popup="true" quick_create="false">
                <field name="name"/>
                <field name="task_type" filters="1"/>
                <field name="assigned_user_id" filters="1"/>
                <field name="order_id"/>
                <field name="state"/>
                <field name="priority"/>
            </calendar>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_dac_work_task_form" model="ir.ui.view">
        <field name="name">dac.work.task.form</field>
        <field name="model">dac.work.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <header>
                    <button name="action_start" string="Bắt đầu" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done" string="Hoàn thành" type="object"
                            class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Huỷ" type="object"
                            invisible="state in ('done','cancelled')"/>
                    <button name="action_reset_draft" string="Đặt lại" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group string="Thông tin chung">
                            <field name="name"/>
                            <field name="task_type"/>
                            <field name="priority"/>
                            <field name="deadline"/>
                            <field name="remind_at"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group string="Liên kết">
                            <field name="order_id"/>
                            <field name="conversation_id"/>
                            <field name="created_by_agent" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô tả">
                            <field name="description" widget="html" placeholder="Mô tả chi tiết task..."/>
                        </page>
                        <page string="Ghi chú nội bộ">
                            <field name="notes" widget="text" placeholder="Ghi chú cho nội bộ..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Window Action: tất cả tasks (Manager) -->
    <record id="action_dac_work_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">dac.work.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Window Action: công việc của tôi (tất cả nhân viên) -->
    <record id="action_dac_my_tasks" model="ir.actions.act_window">
        <field name="name">Việc của tôi</field>
        <field name="res_model">dac.work.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('assigned_user_id', '=', uid)]</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu: Việc của tôi (Sale + Manager + Design + Production) -->
    <menuitem id="menu_dac_my_tasks"
              name="Việc của tôi"
              action="action_dac_my_tasks"
              parent="home_menu.home_root"
              groups="dac_erp.group_dac_erp_sale,dac_erp.group_dac_erp_manager,dac_erp.group_dac_erp_design,dac_erp.group_dac_erp_production"
              sequence="200"/>

    <!-- Menu: Dashboard Tasks (Manager) -->
    <menuitem id="menu_dac_task_dashboard"
              name="Dashboard Công việc"
              action="dac_erp.action_dac_task_dashboard"
              parent="home_menu.home_root"
              groups="dac_erp.group_dac_erp_manager"
              sequence="203"/>

    <!-- Menu: Tất cả tasks (Manager) -->
    <menuitem id="menu_dac_work_task"
              name="Tất cả Công việc"
              action="action_dac_work_task"
              parent="home_menu.home_root"
              groups="dac_erp.group_dac_erp_manager"
              sequence="210"/>

    <!-- =====================================================
         CALENDAR: lịch công việc theo ngày cho từng nhóm
         ===================================================== -->

    <!-- Calendar action: Thiết kế (record rule design tự giới hạn task của user) -->
    <record id="action_dac_task_calendar_design" model="ir.actions.act_window">
        <field name="name">Lịch thiết kế</field>
        <field name="res_model">dac.work.task</field>
        <field name="view_mode">calendar,list</field>
        <field name="view_id" ref="view_dac_work_task_calendar"/>
        <field name="search_view_id" ref="view_dac_work_task_search"/>
        <field name="domain">[('task_type', '=', 'design')]</field>
        <field name="context">{'search_default_my_tasks': 1}</field>
    </record>

    <!-- Calendar action: Sản xuất/thi công -->
    <record id="action_dac_task_calendar_production" model="ir.actions.act_window">
        <field name="name">Lịch sản xuất</field>
        <field name="res_model">dac.work.task</field>
        <field name="view_mode">calendar,list</field>
        <field name="view_id" ref="view_dac_work_task_calendar"/>
        <field name="search_view_id" ref="view_dac_work_task_search"/>
        <field name="domain">[('task_type', 'in', ['production', 'survey', 'supplement'])]</field>
        <field name="context">{'search_default_my_tasks': 1}</field>
    </record>

    <!-- Calendar action: Sale nắm lịch thiết kế + sản xuất để phân bổ.
         Record rule giới hạn: sale (own) → task đơn của mình; sale_all → tất cả. -->
    <record id="action_dac_task_calendar_sale" model="ir.actions.act_window">
        <field name="name">Lịch Thiết kế &amp; Sản xuất</field>
        <field name="res_model">dac.work.task</field>
        <field name="view_mode">calendar,list</field>
        <field name="view_id" ref="view_dac_work_task_calendar"/>
        <field name="search_view_id" ref="view_dac_work_task_search"/>
        <field name="domain">[('task_type', 'in', ['design', 'production'])]</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu Lịch dưới root Thiết kế -->
    <menuitem id="menu_dac_task_calendar_design"
              name="Lịch làm việc"
              action="action_dac_task_calendar_design"
              parent="dac_erp.dac_design_root_menu"
              groups="dac_erp.group_dac_erp_design"
              sequence="7"/>

    <!-- Menu Lịch dưới root Sản xuất -->
    <menuitem id="menu_dac_task_calendar_production"
              name="Lịch làm việc"
              action="action_dac_task_calendar_production"
              parent="dac_erp.dac_production_root_menu"
              groups="dac_erp.group_dac_erp_production"
              sequence="7"/>

    <!-- Inherit sale.order custom form: thêm tab Tasks -->
    <record id="view_sale_order_form_task_tab" model="ir.ui.view">
        <field name="name">sale.order.form.task.tab</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="dac_erp.dac_sale_order_custom_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Tasks" name="tasks_tab">
                    <field name="task_ids" context="{'default_order_id': id}">
                        <list string="Tasks" editable="bottom"
                              decoration-success="state == 'done'"
                              decoration-muted="state == 'cancelled'">
                            <field name="name"/>
                            <field name="task_type"/>
                            <field name="state" widget="badge"/>
                            <field name="priority"/>
                            <field name="deadline"/>
                            <field name="assigned_user_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
