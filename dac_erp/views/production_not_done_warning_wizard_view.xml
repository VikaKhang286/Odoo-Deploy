<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_production_not_done_warning_wizard_form" model="ir.ui.view">
            <field name="name">production.not.done.warning.wizard.form</field>
            <field name="model">production.not.done.warning.wizard</field>
            <field name="arch" type="xml">
                <form string="Sản xuất chưa hoàn tất">
                    <div class="alert alert-warning" role="alert">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <strong>Đơn sản xuất chưa được xác nhận hoàn tất!</strong>
                        <p class="mb-0 mt-1">Vui lòng xác nhận trước khi tiến hành giao hàng.</p>
                    </div>
                    <footer>
                        <button string="Trở về" special="cancel" class="btn-primary"/>
                        <button name="action_confirm_and_proceed"
                                type="object"
                                string="Xác nhận đã sản xuất và tiến hành giao hàng"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
