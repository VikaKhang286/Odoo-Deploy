<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rule đơn giản: Sale users chỉ thấy đơn hàng của mình -->
        <record id="sale_order_rule_own_orders" model="ir.rule">
            <field name="name">Sale Orders: Own Orders Only</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_sale'))]"/>
        </record>

        <!-- Rule Sale All: Xem tất cả đơn hàng -->
        <record id="sale_order_rule_sale_all_orders" model="ir.rule">
            <field name="name">Sale Orders: All Orders for Sale All</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_sale_all'))]"/>
        </record>

        <!-- Rule đơn giản: Manager thấy tất cả đơn hàng -->
        <record id="sale_order_rule_all_orders" model="ir.rule">
            <field name="name">Sale Orders: All Orders for Managers</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_manager'))]"/>
        </record>

        <!-- Rule cho Design: CHỈ XEM đơn được assign cho mình -->
        <record id="sale_order_rule_design_assigned" model="ir.rule">
            <field name="name">Sale Orders: Design Assigned Orders Only</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('user_id_design', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_design'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule cho Production: CHỈ XEM đơn được assign cho mình -->
        <record id="sale_order_rule_production_assigned" model="ir.rule">
            <field name="name">Sale Orders: Production Assigned Orders Only</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">['|', ('user_id_production', '=', user.id), ('production_group_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_production'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
