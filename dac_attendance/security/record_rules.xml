<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- dac.attendance.leave: nhân viên chỉ xem đơn của mình -->
        <record id="rule_dac_leave_own_employee" model="ir.rule">
            <field name="name">Phép: NV chỉ xem đơn của mình</field>
            <field name="model_id" ref="model_dac_attendance_leave"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- dac.attendance.leave: manager xem tất cả -->
        <record id="rule_dac_leave_manager" model="ir.rule">
            <field name="name">Phép: Quản lý xem tất cả</field>
            <field name="model_id" ref="model_dac_attendance_leave"/>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- dac.attendance.amendment: nhân viên chỉ xem đơn của mình -->
        <record id="rule_dac_amendment_own_employee" model="ir.rule">
            <field name="name">Điều chỉnh: NV chỉ xem đơn của mình</field>
            <field name="model_id" ref="model_dac_attendance_amendment"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- dac.attendance.amendment: manager xem tất cả -->
        <record id="rule_dac_amendment_manager" model="ir.rule">
            <field name="name">Điều chỉnh: Quản lý xem tất cả</field>
            <field name="model_id" ref="model_dac_attendance_amendment"/>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
