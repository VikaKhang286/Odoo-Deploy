<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Camera dialog for photo check-in/check-out -->
    <t t-name="dac_attendance.CameraDialog">
        <Dialog title="dialogTitle" size="'md'">
            <div class="o_dac_camera_dialog">

                <!-- Error message -->
                <div t-if="state.errorMessage" class="alert alert-danger mb-3">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <t t-esc="state.errorMessage"/>
                </div>

                <!-- Camera preview (before photo taken) -->
                <div t-if="!state.photoTaken" class="o_dac_camera_preview text-center">
                    <div t-if="!state.cameraReady and !state.errorMessage"
                         class="d-flex justify-content-center align-items-center"
                         style="height: 300px; background: #1a1a2e;">
                        <div class="text-white">
                            <i class="fa fa-spinner fa-spin fa-2x mb-2 d-block"/>
                            <span>Đang mở camera...</span>
                        </div>
                    </div>
                    <video t-ref="cameraVideo"
                           autoplay="true" playsinline="true" muted="true"
                           t-att-style="state.cameraReady ? 'width:100%;max-height:400px;border-radius:8px;' : 'display:none;'"
                           />
                    <canvas t-ref="cameraCanvas" style="display:none;"/>

                    <!-- GPS status -->
                    <div class="mt-2 small">
                        <span t-if="state.gpsStatus === 'loading'" class="text-muted">
                            <i class="fa fa-spinner fa-spin me-1"/>Đang lấy vị trí GPS...
                        </span>
                        <span t-elif="state.gpsStatus === 'ready'" class="text-success">
                            <i class="fa fa-map-marker me-1"/>GPS: <t t-esc="state.gpsLat?.toFixed(4)"/>, <t t-esc="state.gpsLng?.toFixed(4)"/>
                        </span>
                        <span t-elif="state.gpsStatus === 'error'" class="text-warning">
                            <i class="fa fa-warning me-1"/>Không lấy được GPS
                        </span>
                        <span t-elif="state.gpsStatus === 'unavailable'" class="text-muted">
                            <i class="fa fa-info-circle me-1"/>GPS không khả dụng
                        </span>
                    </div>

                    <!-- Capture button -->
                    <button t-if="state.cameraReady"
                            class="btn btn-primary btn-lg mt-3 w-100"
                            t-on-click="capturePhoto">
                        <i class="fa fa-camera me-2"/>Chụp ảnh
                    </button>
                </div>

                <!-- Photo preview (after photo taken) -->
                <div t-if="state.photoTaken" class="o_dac_photo_preview text-center">
                    <img t-att-src="state.photoDataUrl"
                         style="width:100%;max-height:400px;border-radius:8px;object-fit:contain;"
                         alt="Ảnh chấm công"/>

                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-secondary flex-fill"
                                t-on-click="retakePhoto"
                                t-att-disabled="state.submitting">
                            <i class="fa fa-refresh me-1"/>Chụp lại
                        </button>
                        <button class="btn btn-success flex-fill"
                                t-on-click="confirmPhoto"
                                t-att-disabled="state.submitting">
                            <t t-if="state.submitting">
                                <i class="fa fa-spinner fa-spin me-1"/>Đang gửi...
                            </t>
                            <t t-else="">
                                <i class="fa fa-check me-1"/>Xác nhận
                            </t>
                        </button>
                    </div>
                </div>

            </div>
        </Dialog>
    </t>

</templates>
