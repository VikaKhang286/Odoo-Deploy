<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dac_attendance_leave_list" model="ir.ui.view">
        <field name="name">dac.attendance.leave.list</field>
        <field name="model">dac.attendance.leave</field>
        <field name="arch" type="xml">
            <list string="Đơn nghỉ phép" decoration-success="state == 'approved'"
                  decoration-warning="state == 'pending'"
                  decoration-muted="state in ('cancelled', 'refused')">
                <field name="employee_id"/>
                <field name="leave_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="number_of_days"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'refused'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="approved_by" optional="hide"/>
                <button name="action_approve" string="Duyệt" type="object"
                        icon="fa-check" class="btn-success"
                        groups="hr_attendance.group_hr_attendance_manager"
                        invisible="state != 'pending'"/>
                <button name="action_refuse" string="Từ chối" type="object"
                        icon="fa-times" class="btn-danger"
                        groups="hr_attendance.group_hr_attendance_manager"
                        invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_dac_attendance_leave_form" model="ir.ui.view">
        <field name="name">dac.attendance.leave.form</field>
        <field name="model">dac.attendance.leave</field>
        <field name="arch" type="xml">
            <form string="Đơn nghỉ phép">
                <header>
                    <button name="action_approve" string="Duyệt" type="object"
                            class="btn-primary"
                            groups="hr_attendance.group_hr_attendance_manager"
                            invisible="state != 'pending'"/>
                    <button name="action_refuse" string="Từ chối" type="object"
                            groups="hr_attendance.group_hr_attendance_manager"
                            invisible="state != 'pending'"/>
                    <button name="action_cancel" string="Hủy đơn" type="object"
                            invisible="state not in ('draft','pending')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,refused"/>
                </header>
                <sheet>
                    <group>
                        <group string="Thông tin nhân viên">
                            <field name="employee_id"/>
                            <field name="leave_type" widget="radio"/>
                        </group>
                        <group string="Thời gian">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="number_of_days"/>
                        </group>
                    </group>
                    <group string="Lý do">
                        <field name="reason" nolabel="1" placeholder="Nhập lý do nghỉ phép..."/>
                    </group>
                    <group string="Kết quả duyệt" invisible="state not in ('approved','refused')">
                        <field name="approved_by" readonly="1"/>
                        <field name="approved_date" readonly="1"/>
                        <field name="refuse_reason" readonly="1"
                               invisible="state != 'refused'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dac_attendance_leave_search" model="ir.ui.view">
        <field name="name">dac.attendance.leave.search</field>
        <field name="model">dac.attendance.leave</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm đơn nghỉ phép">
                <field name="employee_id"/>
                <field name="leave_type"/>
                <filter name="pending" string="Chờ duyệt" domain="[('state','=','pending')]"/>
                <filter name="approved" string="Đã duyệt" domain="[('state','=','approved')]"/>
                <filter name="refused" string="Từ chối" domain="[('state','=','refused')]"/>
                <separator/>
                <filter name="annual" string="Phép năm" domain="[('leave_type','=','annual')]"/>
                <filter name="sick" string="Phép bệnh" domain="[('leave_type','=','sick')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_employee" string="Nhân viên" context="{'group_by':'employee_id'}"/>
                    <filter name="group_type" string="Loại phép" context="{'group_by':'leave_type'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dac_attendance_leave" model="ir.actions.act_window">
        <field name="name">Đơn nghỉ phép</field>
        <field name="res_model">dac.attendance.leave</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dac_attendance_leave_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

</odoo>
