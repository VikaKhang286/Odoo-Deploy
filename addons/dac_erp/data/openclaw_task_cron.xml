<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_dac_openclaw_daily_digest" model="ir.cron">
            <field name="name">DAC OpenClaw Daily Digest</field>
            <field name="model_id" ref="model_dac_work_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_openclaw_daily_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_cron_dac_openclaw_deadline_reminder" model="ir.cron">
            <field name="name">DAC OpenClaw Deadline Reminder</field>
            <field name="model_id" ref="model_dac_work_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_openclaw_deadline_reminders()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_cron_dac_openclaw_overdue_escalation" model="ir.cron">
            <field name="name">DAC OpenClaw Overdue Escalation</field>
            <field name="model_id" ref="model_dac_work_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_openclaw_overdue_escalations()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_cron_dac_openclaw_manager_digest" model="ir.cron">
            <field name="name">DAC OpenClaw Manager Digest</field>
            <field name="model_id" ref="model_dac_work_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_openclaw_manager_digest()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
