<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_dac_quick_task_wizard_form" model="ir.ui.view">
            <field name="name">dac.quick.task.wizard.form</field>
            <field name="model">dac.quick.task.wizard</field>
            <field name="arch" type="xml">
                <form string="Tạo Task Nhanh">
                    <field name="order_id" invisible="1"/>
                    <group>
                        <field name="assigned_user_id" string="Người thực hiện"
                               widget="many2one_avatar_user"
                               placeholder="Chọn người thực hiện..."/>
                        <field name="name" string="Tiêu đề"
                               placeholder="Nhập tiêu đề task..."/>
                        <field name="deadline" string="Hạn chót"/>
                    </group>
                    <group>
                        <field name="description" string="Mô tả"
                               widget="text"
                               placeholder="Mô tả chi tiết (không bắt buộc)..."
                               nolabel="1"
                               colspan="2"/>
                    </group>
                    <footer>
                        <button name="action_create_task"
                                type="object"
                                string="Tạo Task"
                                class="btn-primary"
                                invisible="not name"/>
                        <button string="Huỷ" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
