<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view: Dashboard Công việc -->
    <record id="view_dac_task_dashboard_form" model="ir.ui.view">
        <field name="name">dac.task.dashboard.form</field>
        <field name="model">dac.task.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard Công việc" create="false" delete="false">
                <header>
                    <button name="action_refresh" string="Làm mới" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_my_tasks"
                                class="oe_stat_button" icon="fa-tasks" type="object">
                            <field name="my_tasks_count" widget="statinfo" string="Việc của tôi"/>
                        </button>
                        <button name="action_open_overdue_tasks"
                                class="oe_stat_button" icon="fa-exclamation-circle" type="object">
                            <field name="overdue_count" widget="statinfo" string="Quá hạn"/>
                        </button>
                        <button name="action_open_all_tasks"
                                class="oe_stat_button" icon="fa-list-alt" type="object"
                                invisible="not is_manager">
                            <field name="total_tasks" widget="statinfo" string="Tất cả"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h2>Dashboard Công việc</h2>
                        <div class="text-muted small" invisible="is_manager">
                            Hiển thị công việc được giao cho bạn.
                        </div>
                        <div class="text-muted small" invisible="not is_manager">
                            Hiển thị tất cả công việc trong hệ thống.
                        </div>
                    </div>

                    <group>
                        <group string="Tình trạng công việc">
                            <field name="draft_count" string="Chờ làm" readonly="1"/>
                            <field name="in_progress_count" string="Đang làm" readonly="1"/>
                            <field name="done_count" string="Hoàn thành" readonly="1"/>
                            <field name="urgent_count" string="Khẩn cấp (chưa đóng)" readonly="1"/>
                        </group>
                    </group>

                    <group string="Phân công theo nhân viên"
                           invisible="not is_manager"
                           col="1">
                        <field name="employee_stats_html" widget="html" nolabel="1"/>
                    </group>

                    <field name="is_manager" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action: mở dashboard -->
    <record id="action_dac_task_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Công việc</field>
        <field name="res_model">dac.task.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
