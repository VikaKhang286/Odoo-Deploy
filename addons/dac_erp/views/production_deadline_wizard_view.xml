<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_production_deadline_wizard_form" model="ir.ui.view">
            <field name="name">production.deadline.wizard.form</field>
            <field name="model">production.deadline.wizard</field>
            <field name="arch" type="xml">
                <form string="Ngày hoàn thành sản xuất">
                    <field name="order_name" invisible="1"/>
                    <field name="default_deadline_days" invisible="1"/>
                    <field name="default_deadline_date" invisible="1"/>

                    <p class="text-muted mb-3">Chưa nhập ngày hoàn thành sản xuất.</p>

                    <group>
                        <field name="production_deadline" string="Ngày hoàn thành" placeholder="Chọn ngày hoàn thành"/>
                    </group>

                    <footer>
                        <button name="action_confirm"
                                type="object"
                                string="Tiến hành sản xuất"
                                class="btn-primary"
                                invisible="not production_deadline"/>
                        <button name="action_use_default_deadline"
                                type="object"
                                string="Mặc định"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
