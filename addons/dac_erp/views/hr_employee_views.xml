<odoo>
    <record id="view_hr_employee_form_dac_role" model="ir.ui.view">
        <field name="name">hr.employee.form.dac.role</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dac_create_user"
                        type="object"
                        string="Tạo tài khoản User"
                        class="oe_highlight"
                        groups="base.group_system"
                        invisible="user_id"/>
            </xpath>
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="dac_role" string="Vai trò DAC"
                       groups="base.group_system" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
