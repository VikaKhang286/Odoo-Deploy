<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_delivery_address_wizard_form" model="ir.ui.view">
            <field name="name">delivery.address.wizard.form</field>
            <field name="model">delivery.address.wizard</field>
            <field name="arch" type="xml">
                <form string="Thông tin giao hàng">
                    <field name="order_name" invisible="1"/>
                    <field name="has_delivery_address" invisible="1"/>

                    <p class="text-muted mb-3">Vui lòng nhập địa chỉ giao hàng trước khi xác nhận.</p>

                    <group>
                        <field name="delivery_address"
                               string="Địa chỉ giao hàng"
                               widget="text"
                               placeholder="Nhập địa chỉ giao hàng..."/>
                    </group>

                    <footer>
                        <button name="action_confirm_delivery"
                                type="object"
                                string="Tiến hành giao hàng"
                                class="btn-primary"
                                invisible="not has_delivery_address"/>
                        <button name="action_mark_customer_pickup"
                                type="object"
                                string="Khách đến nhận hàng"
                                class="btn-secondary"
                                invisible="has_delivery_address"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
