<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_outbound_webhook_log_tree" model="ir.ui.view">
        <field name="name">dac_openclaw.outbound.webhook.log.tree</field>
        <field name="model">dac_openclaw.outbound.webhook.log</field>
        <field name="arch" type="xml">
            <list string="Outbound Webhooks" default_order="id desc">
                <field name="id"/>
                <field name="occurred_at"/>
                <field name="event_type"/>
                <field name="state" decoration-success="state == 'sent'"
                       decoration-warning="state == 'failed'"
                       decoration-danger="state == 'giveup'"
                       decoration-muted="state == 'skipped'"/>
                <field name="retry_count"/>
                <field name="http_status_code"/>
                <field name="sale_order_id"/>
                <field name="conversation_id"/>
                <field name="task_id"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="view_outbound_webhook_log_form" model="ir.ui.view">
        <field name="name">dac_openclaw.outbound.webhook.log.form</field>
        <field name="model">dac_openclaw.outbound.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Outbound Webhook" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Event">
                            <field name="event_id"/>
                            <field name="event_type"/>
                            <field name="occurred_at"/>
                            <field name="state"/>
                        </group>
                        <group string="Delivery">
                            <field name="retry_count"/>
                            <field name="last_attempt_at"/>
                            <field name="next_retry_at"/>
                            <field name="http_status_code"/>
                            <field name="target_url"/>
                        </group>
                    </group>
                    <group string="References">
                        <field name="sale_order_id"/>
                        <field name="conversation_id"/>
                        <field name="task_id"/>
                        <field name="partner_id"/>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json" widget="ace" options="{'mode': 'json'}"/>
                            <field name="signature"/>
                        </page>
                        <page string="Response">
                            <field name="response_body" widget="text"/>
                            <field name="error_message" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_outbound_webhook_log_search" model="ir.ui.view">
        <field name="name">dac_openclaw.outbound.webhook.log.search</field>
        <field name="model">dac_openclaw.outbound.webhook.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_id"/>
                <field name="event_type"/>
                <field name="sale_order_id"/>
                <field name="conversation_id"/>
                <field name="task_id"/>
                <filter name="state_pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="state_failed" string="Failed" domain="[('state','=','failed')]"/>
                <filter name="state_sent" string="Sent" domain="[('state','=','sent')]"/>
                <filter name="state_giveup" string="Give Up" domain="[('state','=','giveup')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_outbound_webhook_log" model="ir.actions.act_window">
        <field name="name">OpenClaw Webhook Log</field>
        <field name="res_model">dac_openclaw.outbound.webhook.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_outbound_webhook_log_search"/>
    </record>
</odoo>
