<odoo>
  <data>
    <record id="view_dac_sales_goal_list" model="ir.ui.view">
      <field name="name">dac.sales.goal.list</field>
      <field name="model">dac.sales.goal</field>
      <field name="arch" type="xml">
        <list string="Mục tiêu/KPI (cá nhân)" create="true" edit="true">
          <field name="user_id"/>
          <field name="company_id"/>
          <field name="year"/>
          <field name="month"/>
          <!-- GIỮ ĐÚNG TÊN FIELD: target_amount -->
          <field name="target_amount"/>
          <field name="kpi_cared_count" optional="hide"/>
          <field name="kpi_quotation_count" optional="hide"/>
          <field name="kpi_closed_count" optional="hide"/>
          <field name="kpi_completed_customer_count" optional="hide"/>
          <field name="active"/>
          <field name="note" optional="hide"/>
          <field name="company_id" invisible="1" optional="hide"/>
          <field name="currency_id" invisible="1" optional="hide"/>
        </list>
      </field>
    </record>

      <!-- ===== LIST/FORM (dac.sales.goal.member) – view riêng ===== 
