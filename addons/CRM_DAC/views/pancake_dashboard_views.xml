<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pancake_sync_dashboard_form" model="ir.ui.view">
            <field name="name">pancake.sync.dashboard.form</field>
            <field name="model">pancake.sync.dashboard</field>
            <field name="arch" type="xml">
                <form string="Continuous Sync Pancake" create="false" edit="true" delete="false">
                    <header>
                        <button name="action_save_configuration" type="object" string="Lưu thiết lập" class="btn-primary"/>
                        <button name="action_run_continuous_sync_now" type="object" string="Chạy quét trong ngày ngay" class="btn-secondary"/>
                        <button name="action_open_manual_full_sync" type="object" string="Đồng bộ tất cả" class="btn-warning" icon="fa-external-link"/>
                        <button name="action_open_sync_logs" type="object" string="Mở log và lỗi đồng bộ" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_pages" type="object" class="oe_stat_button" icon="fa-bookmark">
                                <field name="page_count" widget="statinfo" string="Page active"/>
                            </button>
                            <button name="action_view_conversations" type="object" class="oe_stat_button" icon="fa-comments">
                                <field name="conversation_count" widget="statinfo" string="Conversation"/>
                            </button>
                            <button name="action_view_messages" type="object" class="oe_stat_button" icon="fa-envelope">
                                <field name="message_count" widget="statinfo" string="Tin nhắn"/>
                            </button>
                            <button name="action_open_sync_logs" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                                <field name="recent_sync_error_count" widget="statinfo" string="Lỗi 7 ngày"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>Đồng bộ tin nhắn liên tục</h1>
                            <div class="text-muted">
                                Chỉ giữ các thao tác cần thiết cho vận hành hằng ngày. Cấu hình kỹ thuật và full sync nằm ở phần nâng cao.
                            </div>
                        </div>

                        <group col="2">
                            <group>
                                <group string="Tổng quan nhanh">
                                    <field name="token_configured" readonly="1"/>
                                    <field name="webhook_configured" readonly="1"/>
                                    <field name="token_check_status" readonly="1"/>
                                    <field name="selected_page_count" readonly="1"/>
                                    <field name="unread_conversation_count" readonly="1"/>
                                    <field name="require_processing_count" readonly="1"/>
                                </group>
                                <group string="Thiết lập quan trọng" class="o_pancake_sync_settings_box">
                                    <field name="continuous_sync_active" widget="boolean_toggle"/>
                                    <field name="same_day_sync_interval_minutes"/>
                                    <field name="nightly_two_day_sync_time"/>
                                    <field name="sync_log_retention_days"/>
                                    <field name="continuous_sync_timezone" readonly="1"/>
                                </group>
                            </group>
                            <group string="Tổng quan đồng bộ hôm nay" class="o_pancake_sync_status_widget_box">
                                <field name="conversations_synced_today" readonly="1"/>
                                <field name="messages_synced_today" readonly="1"/>
                                <field name="latest_successful_sync_at" readonly="1"/>
                                <field name="sync_error_status" readonly="1"/>
                                <field name="recent_sync_error_count" readonly="1"/>
                                <field name="latest_sync_error_at" readonly="1"/>
                                <field name="latest_sync_error_message" readonly="1" widget="text"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Chi tiết hôm nay">
                                <group>
                                    <group string="Khách hàng nhắn tin trong ngày">
                                        <field name="today_customer_sync_html" readonly="1" widget="html" nolabel="1"/>
                                        <button name="action_view_conversations" type="object" string="Xem đầy đủ" class="btn-secondary" icon="fa-list"/>
                                    </group>
                                    <group string="Mở nhanh">
                                        <div class="text-muted">
                                            Theo dõi nhanh các hội thoại phát sinh tin nhắn mới trong hôm nay và mở thẳng sang danh sách chi tiết khi cần.
                                        </div>
                                        <button name="action_view_messages" type="object" string="Mở danh sách tin nhắn" class="btn-secondary"/>
                                        <button name="action_view_conversations" type="object" string="Mở danh sách hội thoại" class="btn-secondary"/>
                                        <button name="action_open_sync_logs" type="object" string="Xem log đồng bộ" class="btn-secondary"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Truy cập Pancake">
                                <group>
                                    <group>
                                        <field name="access_token" placeholder="Nhập main access token từ Pancake..."/>
                                        <field name="webhook_secret" placeholder="Webhook secret dự phòng nếu cần dùng về sau..."/>
                                    </group>
                                    <group>
                                        <field name="token_check_message" readonly="1" widget="text"/>
                                        <div class="text-muted">
                                            Nhập token rồi bấm kiểm tra để xác nhận, sau đó mới tải Page và token page.
                                        </div>
                                        <button name="action_check_access_token" type="object" string="Kiểm tra token" class="btn-secondary"/>
                                        <button name="action_load_pages_from_token" type="object" string="Tải Page và tạo token trang" class="btn-secondary"/>
                                        <button name="action_open_page_selection" type="object" string="Mở Trang đồng bộ" class="btn-secondary"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Nâng cao">
                                <group>
                                    <group string="Tham số kỹ thuật">
                                        <field name="sync_batch_size"/>
                                        <field name="circuit_breaker_pause_minutes"/>
                                        <field name="continuous_sync_timezone" readonly="1"/>
                                        <field name="circuit_breaker_until" readonly="1"/>
                                        <field name="last_conv_pointer" readonly="1"/>
                                    </group>
                                    <group string="Theo dõi công việc">
                                        <field name="active_job_state" readonly="1"/>
                                        <field name="active_job_phase" readonly="1"/>
                                        <field name="active_job_progress" widget="progressbar" readonly="1"/>
                                        <field name="active_job_phase_progress" widget="progressbar" readonly="1"/>
                                        <field name="active_job_started_at" readonly="1"/>
                                        <field name="active_job_finished_at" readonly="1"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Layer liên tục">
                                        <field name="quick_sync_nextcall" string="Lần chạy kế tiếp" readonly="1"/>
                                        <field name="candidate_refresh_last_run_at" readonly="1"/>
                                        <field name="candidate_refresh_conversations_checked" readonly="1"/>
                                        <field name="candidate_refresh_error_count" readonly="1"/>
                                        <field name="smart_sync_nextcall" string="Lần chạy kế tiếp" readonly="1"/>
                                        <field name="same_day_last_run_at" readonly="1"/>
                                        <field name="same_day_conversations_checked" readonly="1"/>
                                        <field name="same_day_messages_created" readonly="1"/>
                                        <field name="same_day_error_count" readonly="1"/>
                                        <field name="deep_sync_nextcall" string="Lần chạy kế tiếp" readonly="1"/>
                                        <field name="nightly_two_day_last_run_at" readonly="1"/>
                                        <field name="nightly_two_day_conversations_checked" readonly="1"/>
                                        <field name="nightly_two_day_messages_created" readonly="1"/>
                                        <field name="nightly_two_day_error_count" readonly="1"/>
                                    </group>
                                    <group string="Full sync">
                                        <div class="text-muted">
                                            Đồng bộ tất cả là tác vụ thủ công riêng, dùng khi cần quét lại snapshot lớn. Màn này chỉ điều hướng, không tự chạy full sync trực tiếp ở đây.
                                        </div>
                                        <button name="action_open_manual_full_sync" type="object" string="Mở màn Đồng bộ tất cả" class="btn-warning" icon="fa-external-link"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_pancake_sync_dashboard" model="ir.actions.server">
            <field name="name">Continuous Sync Pancake</field>
            <field name="model_id" ref="model_pancake_sync_dashboard"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_dashboard()</field>
        </record>
    </data>
</odoo>
