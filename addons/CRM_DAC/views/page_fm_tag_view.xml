<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List -->
        <record id="view_page_fm_tag_list" model="ir.ui.view">
            <field name="name">page.fm.tag.list</field>
            <field name="model">page.fm.tag</field>
            <field name="arch" type="xml">
            <list>
                <field name="page_id"/>
                <field name="name"/>
                <field name="tag_fm_id"/>
                <field name="odoo_tag_code"/>
                <field name="odoo_tag_label"/>
                <field name="active"/>
            </list>
            </field>
        </record>

        <!-- Form -->
        <record id="view_page_fm_tag_form" model="ir.ui.view">
            <field name="name">page.fm.tag.form</field>
            <field name="model">page.fm.tag</field>
            <field name="arch" type="xml">
            <form string="Pancake Tag">
                <sheet>
                <group>
                    <field name="page_id" required="1"/>
                    <field name="name" required="1"/>
                    <field name="tag_fm_id" required="1"/>
                </group>
                <group string="Tag nội bộ Odoo">
                    <field name="odoo_tag_code" placeholder="VD: LEAD_HOT, DROP, NEED_QUOTE..."/>
                    <field name="odoo_tag_label" placeholder="Diễn giải cho mã nội bộ (tuỳ chọn)"/>
                </group>
                <group>
                    <field name="active"/>
                    <field name="color"/>
                </group>
                </sheet>
            </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_page_fm_tag" model="ir.actions.act_window">
            <field name="name">Pancake Tags</field>
            <field name="res_model">page.fm.tag</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
