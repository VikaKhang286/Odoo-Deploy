<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pancake_message_dashboard_form" model="ir.ui.view">
            <field name="name">pancake.message.dashboard.form</field>
            <field name="model">pancake.message.dashboard</field>
            <field name="arch" type="xml">
                <form string="Dashboard Tin nhắn Pancake" create="false" edit="true" delete="false">
                    <header>
                        <button name="action_reload_dashboard" type="object" string="Tải lại" class="btn-secondary"/>
                    </header>
                    <sheet class="o_pancake_message_dashboard_sheet">
                        <div class="oe_title">
                            <h1>Dashboard Tin nhắn Pancake</h1>
                            <div class="text-muted">
                                Một màn hình để xem hội thoại, tin nhắn, khách hàng, đơn hàng và vận hành đồng bộ.
                            </div>
                        </div>

                        <group>
                            <group string="Tổng quan hôm nay">
                                <field name="selected_page_count" readonly="1"/>
                                <field name="conversation_count" readonly="1"/>
                                <field name="message_count" readonly="1"/>
                                <field name="conversations_synced_today" readonly="1"/>
                                <field name="messages_synced_today" readonly="1"/>
                                <field name="latest_successful_sync_at" readonly="1"/>
                            </group>
                            <group string="Hành động chính">
                                <button name="action_run_continuous_sync_now" type="object" string="Kiểm tra ngay" class="btn-primary"/>
                                <button name="action_run_same_day_sync_now" type="object" string="Quét lại trong ngày" class="btn-secondary"/>
                                <button name="action_open_manual_full_sync" type="object" string="Đồng bộ tất cả" class="btn-secondary"/>
                                <button name="action_open_sync_logs" type="object" string="Mở log và lỗi đồng bộ" class="btn-secondary"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Vận hành">
                                <group>
                                    <group string="Thiết lập quan trọng" class="o_pancake_sync_settings_box">
                                        <field name="continuous_sync_active" widget="boolean_toggle"/>
                                        <field name="same_day_sync_interval_minutes"/>
                                        <field name="nightly_two_day_sync_time"/>
                                        <field name="sync_log_retention_days"/>
                                        <field name="continuous_sync_timezone" readonly="1"/>
                                        <button name="action_save_configuration" type="object" string="Lưu thiết lập" class="btn-primary"/>
                                    </group>
                                    <group string="Lỗi gần nhất">
                                        <field name="latest_sync_error_at" readonly="1"/>
                                        <field name="latest_sync_error_message" readonly="1" widget="text"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Nâng cao" groups="dac_erp.group_dac_erp_manager,base.group_system">
                                <group>
                                    <group string="Kỹ thuật nguồn">
                                        <field name="access_token" password="True"/>
                                        <field name="webhook_secret" password="True"/>
                                        <field name="token_check_status" readonly="1"/>
                                        <field name="token_check_at" readonly="1"/>
                                    </group>
                                    <group string="Tiện ích">
                                        <button name="action_check_access_token" type="object" string="Kiểm tra token" class="btn-secondary"/>
                                        <button name="action_load_pages_from_token" type="object" string="Tải Page và tạo token trang" class="btn-secondary"/>
                                        <button name="action_open_page_selection" type="object" string="Mở Trang đồng bộ" class="btn-secondary"/>
                                        <button name="action_run_recent_72h_sync_now" type="object" string="Quét lại 72 giờ gần nhất" class="btn-secondary"/>
                                        <button name="action_cleanup_sync_logs_now" type="object" string="Dọn log cũ ngay" class="btn-secondary"/>
                                        <button name="action_open_message_sync_monitor" type="object" string="Mở màn đồng bộ toàn bộ" class="btn-secondary"/>
                                        <button name="action_open_active_message_sync_job" type="object" string="Mở job đồng bộ toàn bộ hiện tại" class="btn-secondary" invisible="not active_job_id"/>
                                    </group>
                                </group>
                                <group string="Báo cáo layer">
                                    <group>
                                        <field name="candidate_refresh_last_run_at" readonly="1"/>
                                        <field name="candidate_refresh_conversations_checked" readonly="1"/>
                                        <field name="candidate_refresh_error_count" readonly="1"/>
                                        <field name="same_day_last_run_at" readonly="1"/>
                                        <field name="same_day_conversations_checked" readonly="1"/>
                                        <field name="same_day_messages_created" readonly="1"/>
                                        <field name="same_day_error_count" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="nightly_two_day_last_run_at" readonly="1"/>
                                        <field name="nightly_two_day_conversations_checked" readonly="1"/>
                                        <field name="nightly_two_day_messages_created" readonly="1"/>
                                        <field name="nightly_two_day_error_count" readonly="1"/>
                                        <field name="active_job_state" readonly="1"/>
                                        <field name="active_job_phase" readonly="1"/>
                                        <field name="active_job_progress" widget="progressbar" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_pancake_message_dashboard" model="ir.actions.server">
            <field name="name">Dashboard Tin nhắn Pancake</field>
            <field name="model_id" ref="model_pancake_message_dashboard"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_dashboard()</field>
        </record>
    </data>
</odoo>
