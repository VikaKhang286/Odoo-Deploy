<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_inherit_pancake_links" model="ir.ui.view">
            <field name="name">res.partner.form.pancake.links</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <!-- Conversations -->
                <button name="action_view_conversations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-comments"
                        invisible="conversation_count == 0">
                <field name="conversation_count" widget="statinfo" string="Conversations"/>
                </button>

                <!-- Orders -->
                <button name="action_view_partner_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart">
                <span class="o_stat_info">
                    <span class="o_stat_text">Đơn hàng</span>
                </span>
                </button>
            </xpath>
            </field>
        </record>


        <record id="view_partner_form_inherit_pancake_staff" model="ir.ui.view">
            <field name="name">res.partner.form.pancake.staff</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet//group" position="inside">
                    <group string="Phụ trách (Pancake)">
                        <field name="responsible_user_id"/>
                        <field name="participant_user_ids" widget="many2many_tags"/>
                        <field name="pancake_id" readonly="1" placeholder="Pancake Customer ID"/>
                        <field name="phone_normalized" readonly="1" placeholder="Tự động từ SĐT"/>
                    </group>
                    <group string="Thẻ từ Pancake" name="pancake_tags_group">
                        <field name="pancake_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" placeholder="Tags được đồng bộ từ conversation"/>
                    </group>
                </xpath>
            </field>
        </record>


        <!-- Icon Pancake trong danh sách khách hàng -->
        <record id="view_partner_list_inherit_pancake_icon" model="ir.ui.view">
            <field name="name">res.partner.list.pancake.icon</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='complete_name']" position="after">
                    <field name="pancake_icon_html" widget="html" string="Pancake" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Bổ sung filter tìm nhanh khách từ Pancake -->
        <record id="view_res_partner_filter_inherit_pancake" model="ir.ui.view">
            <field name="name">res.partner.search.pancake</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="pancake_only" string="Khách từ Pancake"
                        domain="[('conversation_ids','!=', False)]"/>
                <!-- <filter name="pancake_tags" string="Tags từ Pancake"
                        domain="[('pancake_tag_ids', '!=', False)]"/> -->
            </xpath>
            </field>
        </record>
    </data>
</odoo>